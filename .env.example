# --- Supabase (Project Settings -> API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=      # or NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=                 # SERVER ONLY. Never expose to the browser.

# --- LiveKit (video calls) ---------------------------------------------------
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Razorpay (payments) -----------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=                   # same secret you set on the webhook in the Razorpay dashboard

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Sentry (error tracking; optional, off until the DSN is set) --------------
NEXT_PUBLIC_SENTRY_DSN=                    # Sentry -> Project Settings -> Client Keys (DSN)
SENTRY_ORG=                                # build-time only: uploads source maps
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=                         # SERVER/BUILD ONLY. Sentry -> Settings -> Auth Tokens

# --- Email (booking confirmations; optional, off until both are set) ---------
RESEND_API_KEY=                            # SERVER ONLY. resend.com -> API Keys
EMAIL_FROM="SOS <bookings@your-domain.com>"  # must be on a domain verified in Resend
NEXT_PUBLIC_CONTACT_EMAIL=                 # shown on the site; also the reply-to on emails
CRON_SECRET=                               # SERVER ONLY. Long random string; Vercel sends it to the daily reminder job
NEXT_PUBLIC_LEGAL_NAME=                    # registered business name for Terms/Privacy
NEXT_PUBLIC_LEGAL_ADDRESS=
